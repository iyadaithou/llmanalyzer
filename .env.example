# ---- App password (single-user auth) ----
# Pick a strong password you'll remember. This is the only thing gating the app.
APP_PASSWORD=change-me-to-something-strong
# Used to sign the login cookie. Any random 32+ char string. If omitted, falls
# back to APP_PASSWORD (OK for local dev, strongly recommended to set explicitly
# in production so rotating the password doesn't invalidate all cookies).
APP_AUTH_SECRET=generate-a-32-char-random-string-here

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Service role key is used SERVER-SIDE ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-xxx
# Optional: shown to OpenRouter in leaderboards
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=LLM Analyzer
